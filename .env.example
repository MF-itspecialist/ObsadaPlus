# Skopiuj jako .env (obok docker-compose.yml).

# Klucz Google Maps z włączonymi Routes API i Geocoding API.
# Ustawiony → trasy i adresy liczy Google (pierwszeństwo). Pusty → OSRM i OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# auto (domyślnie) | google | osrm | haversine
ROUTING_PROVIDER=auto

# Mapa dla OSRM (plik .osm.pbf z https://download.geofabrik.de/). Domyślnie woj. mazowieckie.
# OSRM_PBF_URL=https://download.geofabrik.de/europe/poland-latest.osm.pbf
