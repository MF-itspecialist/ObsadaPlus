# SQLite (dev) — domyślnie. PostgreSQL: postgresql+psycopg2://obsada:obsada@localhost:5432/obsada
DATABASE_URL=sqlite:///./obsada.db
CORS_ORIGINS=http://localhost:5173
# Trasy: auto (Google, gdy jest klucz → OSRM, gdy jest OSRM_URL → szacunek) | google | osrm | haversine
ROUTING_PROVIDER=auto
# Klucz Google (Routes API + Geocoding API). Bez klucza: OpenStreetMap (Nominatim) i OSRM.
GOOGLE_MAPS_API_KEY=
# Serwer OSRM, np. http://localhost:5000 (docker compose --profile osrm up osrm)
OSRM_URL=
AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
# Pierwsze konto obsadzającego — tworzone przy starcie, gdy w bazie nie ma żadnego konta.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# true, gdy aplikacja działa po HTTPS (ciasteczko logowania tylko przez HTTPS)
COOKIE_SECURE=false

# Powiadomienia e-mail (puste SMTP_HOST = wiadomości czekają w skrzynce nadawczej).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=
# Harmonogram w tle (codzienny import meczów, przypomnienia). false = wyłączony.
SCHEDULER_ENABLED=true
