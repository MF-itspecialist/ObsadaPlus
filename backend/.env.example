# SQLite (dev) — domyślnie. PostgreSQL: postgresql+psycopg2://obsada:obsada@localhost:5432/obsada
DATABASE_URL=sqlite:///./obsada.db
CORS_ORIGINS=http://localhost:5173
ROUTING_PROVIDER=haversine
# Adres → współrzędne/dzielnica. Bez klucza używany jest OpenStreetMap (Nominatim).
GOOGLE_MAPS_API_KEY=
AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
